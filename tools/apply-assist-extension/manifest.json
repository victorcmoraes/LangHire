{
  "manifest_version": 3,
  "name": "LangHire Apply Assist",
  "version": "2.0",
  "description": "Walks the LangHire queue (Lever, Greenhouse, Gupy, Ashby, Workable, LinkedIn Easy Apply) in your own Chrome: fills confirmed answers; you review, solve any CAPTCHA and click Submit.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8799/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "LangHire: preencher esta vaga ou abrir a próxima da fila"},
  "content_scripts": [{
    "matches": ["https://jobs.lever.co/*", "https://jobs.eu.lever.co/*", "https://job-boards.greenhouse.io/*",
                "https://boards.greenhouse.io/*", "https://*.gupy.io/*", "https://jobs.ashbyhq.com/*", "https://apply.workable.com/*", "https://www.linkedin.com/*"],
    "js": ["fields.js", "content.js"],
    "run_at": "document_idle"
  }]
}
